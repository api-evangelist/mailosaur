{
  "opencollection": "1.0.0",
  "info": {
    "name": "Mailosaur Analysis Usage API",
    "version": "1.0.0"
  },
  "request": {
    "auth": {
      "type": "basic",
      "username": "{{username}}",
      "password": "{{password}}"
    }
  },
  "items": [
    {
      "info": {
        "name": "Usage",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Get usage limits",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://mailosaur.com/api/usage/limits"
          },
          "docs": "Retrieve account usage limits. Details the current limits and usage for your account. This endpoint requires authentication with an account-level API key."
        },
        {
          "info": {
            "name": "Get usage transactions",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://mailosaur.com/api/usage/transactions"
          },
          "docs": "Retrieves the last 31 days of transactional usage. This endpoint requires authentication with an account-level API key."
        }
      ]
    }
  ],
  "bundled": true
}